# ===== Server =====
PORT=4000
NODE_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173

# ===== MySQL =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=outreach
MYSQL_PASSWORD=outreach_pass
MYSQL_DATABASE=email_outreach

# ===== Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== BullMQ =====
QUEUE_CONCURRENCY=8
QUEUE_PREFIX=email-outreach

# ===== Ethereal SMTP =====
# Leave blank to auto-generate test credentials on first send.
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASS=

# ===== Google OAuth =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ===== Slack OAuth =====
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback
SLACK_BOT_TOKEN=

# ===== Elasticsearch =====
ELASTICSEARCH_NODE=http://127.0.0.1:9200
ELASTICSEARCH_INDEX=email_deliveries
