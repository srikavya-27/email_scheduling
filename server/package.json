{
  "name": "email-outreach-scheduler-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "worker": "tsx watch src/worker.ts",
    "worker:prod": "node dist/worker.js",
    "migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bullmq": "^5.12.0",
    "connect-redis": "^8.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "ioredis": "^5.4.1",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.0",
    "nodemailer": "^6.9.14",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "zod": "^3.23.8",
    "@elastic/elasticsearch": "^8.14.0",
    "axios": "^1.7.2",
    "@bull-board/api": "^9.10.1",
    "@bull-board/express": "^9.10.1",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "csv-parse": "^5.5.0",
    "uuid": "^10.0.0",
    "winston": "^3.13.0",
    "cookie-parser": "^1.4.6",
    "express-rate-limit": "^7.4.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.15",
    "@types/passport": "^1.0.6",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/uuid": "^10.0.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/morgan": "^1.9.9",
    "tsx": "^4.16.0",
    "typescript": "^5.5.3",
    "vitest": "^2.0.0"
  }
}
